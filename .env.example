# ---------- Deployment (docker-compose) ----------
API_DOMAIN=api.example.com          # A record -> VPS IP
EXTRA_DOMAINS=                      # optional: more hostnames served the same (e.g. an old one apps still use)
TURN_DOMAIN=turn.example.com        # A record -> VPS IP
PUBLIC_IP=203.0.113.10              # the VPS public IPv4 (coturn external-ip)
POSTGRES_PASSWORD=                  # openssl rand -hex 24
WEB_CONCURRENCY=2                   # uvicorn workers

# ---------- App ----------
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://app.example.com,https://admin.example.com   # web client + admin dashboard origins

# Secrets: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ADMIN_TOKEN_MINUTES=480

# Sign in with Google: every OAuth client ID that may appear as `aud` (Android, iOS, Web)
GOOGLE_CLIENT_IDS=123-android.apps.googleusercontent.com,123-ios.apps.googleusercontent.com,123-web.apps.googleusercontent.com
# Sign in with Apple: iOS bundle id (+ Services ID for web)
APPLE_AUDIENCES=com.example.friends,com.example.friends.web

# Phone OTP: "console" logs codes (dev). Register a real SMS provider in app/services/otp.py.
OTP_PROVIDER=console                # console (codes in the server log) | textlk
TEXTLK_API_TOKEN=                   # Text.lk → Developers → API token
TEXTLK_SENDER_ID=                   # sender ID approved on your Text.lk account
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_DEV_ECHO=false                  # never true in production (ignored when ENVIRONMENT=production)

# TURN (must match coturn static-auth-secret; compose passes it to coturn)
TURN_SECRET=                        # openssl rand -hex 32
TURN_REALM=friends
TURN_TTL_SECONDS=3600
TURN_TLS_PORTS=5349                 # add 443 only if coturn has its own IP on 443 (see README)

# Matchmaking / WebSocket
SEARCH_TIMEOUT_SECONDS=30
WS_IDLE_TIMEOUT_SECONDS=60
WS_MAX_MESSAGES_PER_SECOND=30
CHAT_MAX_LENGTH=500
CHAT_MAX_PER_10S=10

# Rate limits
LOGIN_RATE_PER_MINUTE=10
OTP_REQUESTS_PER_10MIN=3
REPORTS_PER_HOUR=10

# Billing (server-side receipt verification)
BILLING_FAKE_MODE=false             # dev only: accepts "test_*" tokens; ignored in production
GOOGLE_PLAY_PACKAGE_NAME=com.example.friends
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google-play-sa.json
APPLE_BUNDLE_ID=com.example.friends
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=/app/secrets/AuthKey_XXXXXXXXXX.p8
